# Supabase 配置
# 从 Supabase 控制台获取: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
# 读取和管理操作都在服务端执行，切勿加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 只给 Vercel Preview 配置独立测试项目；缺少任一项时预览构建会停止。
# 不要复制正式库的 URL 或密钥到这两个变量，也不要把它们配置到 Production。
PREVIEW_SUPABASE_URL=
PREVIEW_SUPABASE_SERVICE_ROLE_KEY=
# 不配置时禁用新增、修改和删除；调用时使用 Authorization: Bearer <token>
ADMIN_API_TOKEN=
# Vercel Production 必填：从 Upstash Redis / Vercel Marketplace 获取
# 本地和 Preview 不配置时使用内存计数；Production 缺失时返回 503
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 或使用 Vercel Marketplace 自动注入的这一对变量，无需重复复制令牌
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 图片服务地址；不填时只读取当前站点的同路径静态文件
NEXT_PUBLIC_IMAGE_BASE_URL=
# Cloudflare R2 配置
# 从 Cloudflare Dashboard -> R2 -> 管理 R2 API 令牌 获取
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.r2.dev
